{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NetQuit",
  "version": "2.0.0",
  "identifier": "com.altf4.netquit",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "NetQuit — Automação Universal Multi-Vendor · Acabou, Quitou!",
        "width": 1240,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ]
  }
}
